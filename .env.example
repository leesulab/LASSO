# Exemple de variables d'environnement locales pour le prototype R/Shiny.
# Copier ce fichier vers .env puis renseigner DATA_PATH. Le script
# scripts/run_local.sh charge .env automatiquement. Ce fichier .env n'est pas
# clone ni versionne.
# Ne jamais inscrire ici un jeton ou un mot de passe d'application.

APP_ENV=development
# PROJECT_ROOT est detecte automatiquement par scripts/run_local.sh.
DATA_PATH=/chemin/vers/observatoire
PORT=7660

# Configuration Nextcloud facultative. Les secrets restent saisis dans l'application.
NEXTCLOUD_ACCESS_MODE=account
NEXTCLOUD_PUBLIC_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_ALLOWED_HOSTS=
